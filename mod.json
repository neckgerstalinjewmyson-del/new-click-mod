{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "Earl12.click-picker",
  "name": "Click Picker",
  "version": "v1.0.0",
  "developer": "Earl12",
  "description": "Plays a click sound of your choice (20 included) on every jump, including during replay playback.",
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "Enabled",
      "default": true
    },
    "click-sound": {
      "type": "string",
      "name": "Click Sound",
      "default": "tick",
      "one-of": [
        "tick",
        "pop",
        "snap",
        "thock",
        "tap",
        "blip",
        "bubble",
        "clack",
        "knock",
        "chirp",
        "click",
        "beep",
        "drop",
        "plink",
        "boop",
        "crisp",
        "dull",
        "zap",
        "wood",
        "glass"
      ]
    },
    "volume": {
      "type": "float",
      "name": "Volume",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "control": {
        "slider": true
      }
    },
    "pitch-variation": {
      "type": "float",
      "name": "Random Pitch Variation",
      "description": "Slightly varies pitch so rapid clicking sounds less robotic.",
      "default": 0.0,
      "min": 0.0,
      "max": 0.3,
      "control": {
        "slider": true
      }
    }
  }
}
